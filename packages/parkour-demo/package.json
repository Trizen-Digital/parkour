{
	"name": "@trizendigital/parkour-demo",
	"version": "0.1.0",
	"description": "The parkour demo: the game at parkour.trizen.dev with the Y Bot, its courses, the QA replay player, the benchmark, and the tools and tests behind @trizendigital/parkour.",
	"type": "module",
	"license": "UNLICENSED",
	"repository": { "type": "git", "url": "git+https://github.com/trizen-digital/parkour.git", "directory": "packages/parkour-demo" },
	"homepage": "https://parkour.trizen.dev/",
	"bugs": "https://github.com/trizen-digital/parkour/issues",
	"keywords": [ "three", "parkour", "game", "demo" ],
	"bin": { "parkour-demo": "bin/parkour-demo.mjs" },
	"files": [
		"bin",
		"app",
		"src",
		"public",
		"tools",
		"!tools/*/out",
		"tests",
		"qa",
		"!qa/local",
		"!qa/incoming",
		"!qa/trash",
		"!qa/review",
		"!qa/categories.json",
		"!qa/bench",
		"assets",
		"docs",
		"index.html",
		"vite.config.js",
		"vite.nohmr.config.js",
		"README.md"
	],
	"engines": { "node": ">=22" },
	"scripts": {
		"dev": "vite",
		"dev:nohmr": "vite --config vite.nohmr.config.js",
		"build": "vite build",
		"build:package": "vite build --mode package",
		"preview:hosted": "vite build && vite preview --port 5413 --strictPort",
		"prepack": "npm run build:package",
		"start": "node bin/parkour-demo.mjs",
		"test": "node --test tests/*.test.mjs",
		"golden": "node tools/headless/golden.mjs verify",
		"golden:bless": "node tools/headless/golden.mjs bless",
		"purity": "node tools/headless/purity.mjs",
		"snapshots": "node tools/headless/snapshot-check.mjs",
		"reach": "node tools/reach/run.mjs",
		"lanes": "node tools/easy/lanes.mjs",
		"bench": "node tools/bench/run.mjs",
		"moves:build": "node tools/moves/build.mjs",
		"moves:check": "node tools/moves/check.mjs",
		"moves:captures": "node tools/moves/captures.mjs",
		"qa:open": "node tools/qa/open.mjs"
	},
	"dependencies": {
		"@trizendigital/parkour": "^0.1.0",
		"@trizendigital/parkour-box3d": "^0.1.0",
		"@trizendigital/parkour-rapier": "^0.1.0",
		"fflate": "0.8.3",
		"three": "0.186.1"
	},
	"devDependencies": {
		"@fontsource/barlow": "5.3.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.1",
		"vite": "8.3.4"
	},
	"publishConfig": { "access": "public" }
}
