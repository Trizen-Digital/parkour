{
	"name": "parkour",
	"private": true,
	"type": "module",
	"description": "Trizen Digital's parkour runner: the @trizendigital/parkour packages and the demo at parkour.trizen.dev.",
	"workspaces": [
		"packages/parkour",
		"packages/parkour-box3d",
		"packages/parkour-rapier",
		"packages/parkour-demo"
	],
	"scripts": {
		"dev": "npm run dev -w @trizendigital/parkour-demo",
		"dev:nohmr": "npm run dev:nohmr -w @trizendigital/parkour-demo",
		"build": "npm run build -w @trizendigital/parkour-demo",
		"preview:hosted": "npm run preview:hosted -w @trizendigital/parkour-demo",
		"test": "npm test -w @trizendigital/parkour-demo",
		"golden": "npm run golden -w @trizendigital/parkour-demo --",
		"golden:bless": "npm run golden:bless -w @trizendigital/parkour-demo --",
		"purity": "npm run purity -w @trizendigital/parkour-demo --",
		"snapshots": "npm run snapshots -w @trizendigital/parkour-demo --",
		"reach": "npm run reach -w @trizendigital/parkour-demo --",
		"lanes": "npm run lanes -w @trizendigital/parkour-demo --",
		"bench": "npm run bench -w @trizendigital/parkour-demo --",
		"moves:build": "npm run moves:build -w @trizendigital/parkour-demo",
		"moves:check": "npm run moves:check -w @trizendigital/parkour-demo",
		"moves:captures": "npm run moves:captures -w @trizendigital/parkour-demo",
		"qa:open": "npm run qa:open -w @trizendigital/parkour-demo --",
		"try": "node tools/try-install.mjs"
	}
}
